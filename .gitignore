# 原始数据和中间产物体积较大，且可由公开数据源与配置重新生成。
data/raw/*
data/interim/*
data/processed/*
!data/raw/.gitkeep
!data/interim/.gitkeep
!data/processed/.gitkeep

# 模型、数组和缓存文件不进入版本控制。
*.fif
*.edf
*.bdf
*.set
*.fdt
*.npy
*.npz
*.joblib
*.pkl
*.h5
*.hdf5
*.zarr/
*.pth
*.pt
*.ckpt
*.safetensors
*.zip
__pycache__/
*.py[cod]
.pytest_cache/
.pytest-*-tmp/
.pytest-tmp-*/
.ruff_cache/
.mypy_cache/
.ipynb_checkpoints/
*.egg-info/
.codex_tmp/

# 本地环境和编辑器配置。
.env
.env.*
.venv/
.conda/
.idea/
.vscode/

# 个人面试备考材料保留本地，不作为研究项目发布。
/docs/17_interview_questions_signals_audio_video.md

# 作者仓库是独立Git checkout；只跟踪资源版本记录，不把它误加入嵌套仓库。
third_party/CBraMod/
models/pretrained/CBraMod/

# 运行结果默认可重新生成；最终入选的图表可单独强制加入 Git。
results/*
!results/README.md
!results/erp_analysis/
results/erp_analysis/*
!results/erp_analysis/analysis_manifest.json
!results/erp_analysis/cluster_summary.csv
!results/erp_analysis/group_statistics.csv
!results/erp_analysis/results_summary.md
!results/erp_analysis/sensitivity_analysis.csv
reports/figures/*
!reports/figures/.gitkeep
!reports/figures/erp_analysis/
!reports/figures/erp_analysis/*.png

# 只开放精选分类图；完整预测、权重和缓存仍按上面的规则忽略。
!reports/figures/final_report/
reports/figures/final_report/*
!reports/figures/final_report/model_comparison.png
!reports/figures/final_report/paired_ba_differences.png
!reports/figures/final_report/confusion_matrices.png

